# Copy to .env.local and fill in. None of these are required for the site to
# build; the forms fall back to safe no-op behaviour until configured.

# ── Sanity (content) ────────────────────────────────────────────────
# Defaults are baked into src/sanity/env.ts; override per environment.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# ── Email / ESP — contact form + newsletter ─────────────────────────
# Provider selector. Unset => the "console" fallback: it logs submissions
# server-side but DELIVERS NOTHING. Pick a real provider before launch.
#   1. Implement it under src/lib/email/providers/
#   2. Register it in src/lib/email/index.ts
#   3. Set EMAIL_PROVIDER + its credentials below.
# The newsletter list MUST be configured for confirmed (double) opt-in.
# Providers evaluated for EU/GDPR: Brevo (FR), MailerLite (EU).
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_NEWSLETTER_LIST_ID=

# ── Friendly Captcha — EU-resident, cookieless spam protection ───────
# Public site key for the client widget. Unset => widget doesn't render
# (honeypot + timing checks still protect the forms).
# NEXT_PUBLIC_FRIENDLY_CAPTCHA_SITEKEY=
# Server API key for verification. Unset => verification skipped in dev.
# Set before launch. See src/lib/captcha.ts.
# FRIENDLY_CAPTCHA_SECRET=
